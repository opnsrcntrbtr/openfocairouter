{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFOC AI Router",
  "version": "0.2.0",
  "identifier": "dev.openfoc.airouter",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenFOC AI Router",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4141; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Free cloud LLM router with automatic fallback",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ofr-router"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
