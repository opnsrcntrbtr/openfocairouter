{
  "name": "openfocairouter",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, free-of-cost AI model router for macOS: one local OpenAI-compatible endpoint across free cloud tiers with automatic fallback.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "vite",
    "build:ui": "tsc -p tsconfig.json && vite build",
    "dev:router": "bun --watch router/src/index.ts",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "icons": "tauri icon app-icon.png",
    "test": "bun test router",
    "typecheck": "tsc -p tsconfig.json && tsc -p router/tsconfig.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/bun": "^1.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
